<Window x:Class="projeto_POO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:projeto_POO"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="1600">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFCDF7FF"/>
                <GradientStop Color="#FF007288" Offset="0.994"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Button x:Name="jogarButton" Content="JOGAR " HorizontalAlignment="Center" VerticalAlignment="Center" Height="132" Width="262" Click="jogarButton_Click" Foreground="White" FontFamily="Papyrus" FontSize="44">
            <Button.BorderBrush>
                <SolidColorBrush Color="#FF707070" Opacity="0"/>
            </Button.BorderBrush>
            <Button.Background>
                <SolidColorBrush Color="#FF0A0544" Opacity="0.5"/>
            </Button.Background>
        </Button>
        <Label Content="Hidden Room" HorizontalAlignment="Center" Margin="0,149,0,0" VerticalAlignment="Top" Height="143" Width="604" FontFamily="Papyrus" FontSize="92" FontWeight="Bold" Foreground="#FF110B5A"/>
    </Grid>
</Window>
